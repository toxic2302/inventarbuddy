# Kopieren nach ".env.stage" und mit echten Werten befuellen.
# Wird mit "docker compose -f docker-compose.prod.yaml --env-file .env.stage up -d" verwendet.

# Docker Image (wird von der CI Pipeline gebaut und gepusht)
APP_IMAGE=ghcr.io/<owner>/inventarbuddy:stage

# Aktives Spring Profil
SPRING_PROFILES_ACTIVE=stage

# Domain fuer Reverse Proxy / TLS (Let's Encrypt)
DOMAIN=stage.example.com

# Datenbank
DATABASE_URL=jdbc:postgresql://<db-host>:5432/inventarbuddy
DATABASE_USER=inventarbuddy
DATABASE_PASSWORD=<change-me>

# Hashicorp Vault (AppRole)
VAULT_HOST=<vault-host>
VAULT_PORT=8200
VAULT_SCHEME=https
VAULT_ROLE_ID=<vault-role-id>
VAULT_SECRET_ID=<vault-secret-id>

# Keycloak
KEYCLOAK_ISSUER_URI=https://<keycloak-host>/realms/inventarbuddy
